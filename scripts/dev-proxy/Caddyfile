# Local proxy for testing via kubectl port-forward.
# Usage: ./scripts/dev-proxy/start.sh [dev|staging|prod]
#
# Requires /etc/hosts entry for the environment hostname (see start.sh).
# Requires: kubectl port-forward to svc/*-frontend-svc on port 3000 (see start.sh).

{$DEV_PROXY_HOST} {
	# Use 127.0.0.1, not localhost — macOS resolves localhost to [::1] but
	# kubectl port-forward only binds on IPv4.
	reverse_proxy 127.0.0.1:3000
	tls internal
}
