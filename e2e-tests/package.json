{
  "name": "wri-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for WRI",
  "main": "test.js",
  "type": "module",
  "scripts": {
    "open": "cypress open",
    "test": "cypress run --browser electron",
    "test:group1": "cypress run --browser electron --spec \"$(node split-tests.js 1 12)\"",
    "test:group2": "cypress run --browser electron --spec \"$(node split-tests.js 2 12)\"",
    "test:group3": "cypress run --browser electron --spec \"$(node split-tests.js 3 12)\"",
    "test:group4": "cypress run --browser electron --spec \"$(node split-tests.js 4 12)\"",
    "test:group5": "cypress run --browser electron --spec \"$(node split-tests.js 5 12)\"",
    "test:group6": "cypress run --browser electron --spec \"$(node split-tests.js 6 12)\"",
    "test:group7": "cypress run --browser electron --spec \"$(node split-tests.js 7 12)\"",
    "test:group8": "cypress run --browser electron --spec \"$(node split-tests.js 8 12)\"",
    "test:group9": "cypress run --browser electron --spec \"$(node split-tests.js 9 12)\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.5.0",
    "cypress-plugin-tab": "^1.0.5",
    "cypress-real-events": "^1.14.0",
    "cypress-terminal-report": "^7.2.1"
  },
  "dependencies": {
    "axe-core": "^4.8.4",
    "cypress-axe": "^1.5.0",
    "cypress-file-upload": "^5.0.8"
  }
}
