{
  "name": "wri-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for WRI",
  "main": "test.js",
  "type": "module",
  "scripts": {
    "open": "cypress open",
    "test": "cypress run --browser electron",
    "test:group": "cypress run --browser electron --spec \"$(node split-tests.js \"$GROUP\" \"$TOTAL_GROUPS\")\"",
    "test:group1": "GROUP=1 TOTAL_GROUPS=6 npm run test:group",
    "test:group2": "GROUP=2 TOTAL_GROUPS=6 npm run test:group",
    "test:group3": "GROUP=3 TOTAL_GROUPS=6 npm run test:group",
    "test:group4": "GROUP=4 TOTAL_GROUPS=6 npm run test:group",
    "test:group5": "GROUP=5 TOTAL_GROUPS=6 npm run test:group",
    "test:group6": "GROUP=6 TOTAL_GROUPS=6 npm run test:group"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.5.0",
    "cypress-plugin-tab": "^1.0.5",
    "cypress-real-events": "^1.14.0",
    "cypress-terminal-report": "^7.2.1"
  },
  "dependencies": {
    "axe-core": "^4.8.4",
    "cypress-axe": "^1.5.0",
    "cypress-file-upload": "^5.0.8"
  }
}
