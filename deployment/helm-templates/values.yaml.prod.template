ckan:
  auth:
    enable: false
  service:
    type: ClusterIP
    port: 80
  ckan:
    replicaCount: 2
    envVarsSecretName: ckan-cloud-centeralized-sql
    env:
      UWSGI_HARAKIRI: "1800"
      UWSGI_HTTP_TIMEOUT: "3600"
      UWSGI_SOCKET_TIMEOUT: "3600"
      CKANEXT__DCAT__ENABLE_CONTENT_NEGOTIATION: "True"
      CKANEXT__REPO__SRCPATH: /srv/app/src
      CKAN_INI: /srv/app/production.ini
      CKAN_SITE_ID: wri-prod
      CKAN_SITE_URL: https://datasets.wri.org
      CKAN_HOMEPAGE_STYLE: "2"
      CKAN__DATAPUSHER__URL: http://wri-prod-datapusher-svc:80/
      CKAN_SVC_PORT_80_TCP_PROTO: tcp
      CKAN__AUTH__ANON_CREATE_DATASET: "False"
      CKAN__AUTH__CREATE_DATASET_IF_NOT_IN_ORGANIZATION: "True"
      CKAN__AUTH__USER_CREATE_GROUPS: "True"
      CKAN__AUTH__USER_CREATE_ORGANIZATIONS: "True"
      CKAN__AUTH__USER_DELETE_GROUPS: "True"
      CKAN__AUTH__USER_DELETE_ORGANIZATIONS: "True"
      CKAN__AUTH__PUBLIC_USER_DETAILS: "False"
      CKAN__GROUP_AND_ORGANIZATION_LIST_ALL_FIELDS_MAX: "150"
      CKAN__CORS_ORIGIN_ALLOW_ALL: "True"
      CKAN__CORS__ORIGIN_ALLOW_ALL: "True"
      CKAN__HARVEST__MQ__TYPE: redis
      CKAN__LOCALE_DEFAULT: en
      CKAN__RESOURCE_PROXY__MAX_FILE_SIZE: "100000000"
      CKAN__SITE_TITLE: WRI Open Data Platform
      CKAN__STORAGE_PATH: /tmp
      CKAN__VIEWS__DEFAULT_VIEWS: pdf_view
      CKAN__PLUGINS: image_view text_view webpage_view resource_proxy datatables_view datastore datapusher activity s3filestore scheming_datasets scheming_organizations scheming_groups harvest wri wri_api_tracking wri_harvester auth hierarchy_display hierarchy_form hierarchy_group_form issues envvars
      CKAN__AUTH__CREATE_UNOWNED_DATASET: "False"
      CKAN__GROUP_AND_ORGANIZATIONS_LIST_ALL_FIELDS_MAX: "150"
      CKAN__AUTH__ALLOW_DATASET_COLLABORATORS: "True"
      CKAN__AUTH__ALLOW_ADMIN_COLLABORATORS: "True"
      CKAN__AUTH__ALLOW_COLLABORATORS_TO_CHANGE_OWNER_ORG: "True"
      CKAN___SCHEMING__DATASET_SCHEMAS: ckanext.wri.schema:ckan_dataset.yaml
      CKAN___SCHEMING__ORGANIZATION_SCHEMAS: ckanext.wri.schema:custom_org_with_address.json
      CKAN___SCHEMING__GROUP_SCHEMAS: ckanext.wri.schema:wri_application.json
      CKAN___SCHEMING__PRESETS: ckanext.wri.schema:presets.json
      CKANEXT__AUTH__INCLUDE_FRONTEND_LOGIN_TOKEN: "True"
      CKAN__DATASTORE__SQLSEARCH__ENABLED: "True"
      CKANEXT__WRI__MIGRATION_DEPLOYMENT_NAME: migration_deployment
      CKANEXT__WRI__MIGRATION_FLOW_NAME: trigger-migration
      CKANEXT__WRI__MIGRATION_DEPLOYMENT_ENV: prod
      CKANEXT__WRI__ODP_URL: https://datasets.wri.org
    hpa:
      enable: true
      minReplicas: 2
      maxReplicas: 3
      targetMemoryUtilizationPercentage: 80
    resources:
      limits:
        cpu: 800m
        memory: 4G
      requests:
        cpu: 400m
        memory: 3G
    image:
      pullPolicy: Always
      repository: {{REGISTRY}}/{{CKAN_REPO}}
      tag: {{CKAN_IMAGE_TAG}}
    runInitContainers: true
    service:
      port: 80
      type: ClusterIP
  datapusher:
    enable: enable
    env:
      DATAPUSHER_MAX_CONTENT_LENGTH: "5368709120"
    resources:
      limits:
        cpu: 800m
        memory: 4.5G
        ephemeral-storage: 15Gi
      requests:
        cpu: 300m
        memory: 4G
        ephemeral-storage: 6Gi
    # Datapusher runs a Prefect serve() runner that executes flows in-process.
    # It must stay a single stable replica: HPA scale-down kills the pod
    # mid-flight and orphans in-progress flow runs in a PENDING state.
    hpa:
      enable: false
      minReplicas: 1
      maxReplicas: 1
      targetMemoryUtilizationPercentage: 80
    image:
      tag: {{DATAPUSHER_IMAGE_TAG}}
      pullPolicy: Always
      repository: {{REGISTRY}}/{{DATAPUSHER_REPO}}
    replicaCount: 1
  migrationApp:
    enable: enable
    env:
      DATAPUSHER_MAX_CONTENT_LENGTH: "5368709120"
    resources:
      limits:
        cpu: 300m
        memory: 1.5G
      requests:
        cpu: 250m
        memory: 1G
    hpa:
      enable: true
      minReplicas: 1
      maxReplicas: 2
      targetMemoryUtilizationPercentage: 80
    image:
      tag: {{MIGRATION_IMAGE_TAG}}
      pullPolicy: Always
      repository: {{REGISTRY}}/{{MIGRATION_REPO}}
    replicaCount: 1
  frontend:
    enable: true
    hpa:
      enable: false
    resources:
      limits:
        cpu: 400m
        memory: 2.2G
      requests:
        cpu: 200m
        memory: 1.8G
    replicaCount: 1
    image:
      repository: {{REGISTRY}}/{{FRONTEND_REPO}}
      tag: {{FRONTEND_IMAGE_TAG}}
    env:
      SITE_TITLE: WRI ODP
      NEXT_PUBLIC_DEPLOYMENT_TYPE: production
    targetPort: 3000
  general:
    autoscaling:
      enable: false
    customResource: true
    projectId: wri-prod
    resources: {}
    useProductionCerts: true
  ingress:
    enable: false  # CKAN via datasets.wri.org (/api, /private-admin); see ingress.frontendInternal* templates
  giftless:
    enable: false
  solr:
    enable: false
    image:
      tag: 8.11.1
    resources:
      limits:
        memory: 3G
        cpu: 0.6
      requests:
        memory: 2.8G
        cpu: 0.4
  ckanmiddleware:
    enable: false
  dataSubscriptions:
    enable: false
  postgresql:
    enable: false
  xloader:
    enable: false
solr:
  nodeSelector: {}
  image:
    repository: ckan/ckan-solr
    tag: 2.10-solr9-spatial
  resources:
    limits:
      memory: 4G
      cpu: 0.8
    requests:
      memory: 3G
      cpu: 0.6
redis:
  architecture: standalone
  image:
    registry: docker.io
    repository: bitnamilegacy/redis
    tag: "7.0.12-debian-11-r0"
  master:
    persistence:
      size: 1G

ingress:
  frontendInternal:
    host: datasets.wri.org
    secretName: datasets.wri.org
  frontendInternalAdmin:
    host: datasets.wri.org
    secretName: datasets.wri.org
  frontendInternalApi:
    host: datasets.wri.org
    secretName: datasets.wri.org
